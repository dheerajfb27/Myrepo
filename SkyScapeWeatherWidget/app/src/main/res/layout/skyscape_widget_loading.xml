<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/skyscape_widget_background"
    android:gravity="top">

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SKYSCAPE  •  BENGALURU"
        android:textColor="#FFBFEFFF"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="sans-serif-light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <TextView
                android:id="@+id/widget_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading weather…"
                android:textColor="#FFF0F7FF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/widget_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="H --°  •  L --°"
                android:textColor="#FFB8C9D8"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_road"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:background="@drawable/skyscape_road_strip">

        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🌄" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="━━━━" android:textColor="#FFF7F4D0" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🌈" android:textSize="12sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="━━━━" android:textColor="#FFF7F4D0" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="🌿" android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_forecast_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:text="3-DAY OUTLOOK"
        android:textColor="#FF79D9FF"
        android:textSize="9sp"
        android:letterSpacing="0.1"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textColor="#FFB8C9D8" android:textSize="9sp" />
            <TextView android:id="@+id/forecast_icon_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="13sp" />
            <TextView android:id="@+id/forecast_temp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--° / --°" android:textColor="#FFFFFFFF" android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tomorrow" android:textColor="#FFB8C9D8" android:textSize="9sp" />
            <TextView android:id="@+id/forecast_icon_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⛅" android:textSize="13sp" />
            <TextView android:id="@+id/forecast_temp_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--° / --°" android:textColor="#FFFFFFFF" android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Day 3" android:textColor="#FFB8C9D8" android:textSize="9sp" />
            <TextView android:id="@+id/forecast_icon_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌦️" android:textSize="13sp" />
            <TextView android:id="@+id/forecast_temp_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--° / --°" android:textColor="#FFFFFFFF" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="4dp">
        <TextView android:id="@+id/shortcut_phone" android:layout_width="0dp" android:layout_height="24dp" android:layout_weight="1" android:gravity="center" android:text="☎ Phone" android:textColor="#FFEAF5FF" android:textSize="9sp" android:background="@drawable/skyscape_shortcut_bg" />
        <TextView android:id="@+id/shortcut_messages" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:text="✉ SMS" android:textColor="#FFEAF5FF" android:textSize="9sp" android:background="@drawable/skyscape_shortcut_bg" />
        <TextView android:id="@+id/shortcut_camera" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:text="◉ Camera" android:textColor="#FFEAF5FF" android:textSize="9sp" android:background="@drawable/skyscape_shortcut_bg" />
        <TextView android:id="@+id/shortcut_telegram" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:text="➤ TG" android:textColor="#FFEAF5FF" android:textSize="9sp" android:background="@drawable/skyscape_shortcut_bg" />
        <TextView android:id="@+id/shortcut_spotify" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center" android:text="♫ Music" android:textColor="#FFEAF5FF" android:textSize="9sp" android:background="@drawable/skyscape_shortcut_bg" />
    </LinearLayout>
</LinearLayout>