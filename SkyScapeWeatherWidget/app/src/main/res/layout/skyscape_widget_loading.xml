<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp"
    android:background="@drawable/skyscape_widget_background"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BENGALURU • TODAY"
                android:textColor="#FFBFEFFF"
                android:textSize="8sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:letterSpacing="0.03"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="#FFFFFFFF"
                android:textSize="27sp"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="3dp">
            <TextView
                android:id="@+id/widget_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading weather…"
                android:textColor="#FFF0F7FF"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/widget_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HIGH --° • LOW --°"
                android:textColor="#FFB8C9D8"
                android:textSize="8sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_road"
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="1dp"
        android:paddingHorizontal="7dp"
        android:background="@drawable/skyscape_road_strip">
        <TextView
            android:id="@+id/widget_scene_sun"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="☀️"
            android:textSize="13sp"
            android:includeFontPadding="false" />
        <TextView
            android:id="@+id/widget_scene_cloud"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="☁️"
            android:textSize="14sp"
            android:includeFontPadding="false" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="━━━━"
            android:textColor="#FFF7F4D0"
            android:textSize="8sp"
            android:includeFontPadding="false" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="☁️"
            android:textColor="#FFD7EAF5"
            android:textSize="12sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_forecast_row"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="1dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textColor="#FFB8C9D8" android:textSize="7sp" />
            <TextView android:id="@+id/forecast_icon_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="10sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/forecast_temp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#FFFFFFFF" android:textSize="7sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sat" android:textColor="#FFB8C9D8" android:textSize="7sp" />
            <TextView android:id="@+id/forecast_icon_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⛅" android:textSize="10sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/forecast_temp_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#FFFFFFFF" android:textSize="7sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sun" android:textColor="#FFB8C9D8" android:textSize="7sp" />
            <TextView android:id="@+id/forecast_icon_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌦️" android:textSize="10sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/forecast_temp_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#FFFFFFFF" android:textSize="7sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mon" android:textColor="#FFB8C9D8" android:textSize="7sp" />
            <TextView android:id="@+id/forecast_icon_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☁️" android:textSize="10sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/forecast_temp_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#FFFFFFFF" android:textSize="7sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tue" android:textColor="#FFB8C9D8" android:textSize="7sp" />
            <TextView android:id="@+id/forecast_icon_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌤️" android:textSize="10sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/forecast_temp_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#FFFFFFFF" android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>


</LinearLayout>