<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/skyscape_widget_background"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BENGALURU • TODAY"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:ellipsize="end"
        android:gravity="center_horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="74dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛅"
            android:textSize="42sp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="#FFFFFFFF"
                android:textSize="38sp"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-light"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connecting to weather…"
                android:textColor="#FFF5FBFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HIGH --°  •  LOW --°"
                android:textColor="#FFD9F1FF"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#55FFFFFF"
        android:text="" />

    <LinearLayout
        android:id="@+id/widget_forecast_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textColor="#FFE6F6FF" android:textSize="9sp" />
            <TextView android:id="@+id/forecast_icon_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="14sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/forecast_temp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#FFFFFFFF" android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tmrw" android:textColor="#FFE6F6FF" android:textSize="9sp" />
            <TextView android:id="@+id/forecast_icon_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⛅" android:textSize="14sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/forecast_temp_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#FFFFFFFF" android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wed" android:textColor="#FFE6F6FF" android:textSize="9sp" />
            <TextView android:id="@+id/forecast_icon_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌦️" android:textSize="14sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/forecast_temp_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#FFFFFFFF" android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thu" android:textColor="#FFE6F6FF" android:textSize="9sp" />
            <TextView android:id="@+id/forecast_icon_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☁️" android:textSize="14sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/forecast_temp_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#FFFFFFFF" android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/forecast_day_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fri" android:textColor="#FFE6F6FF" android:textSize="9sp" />
            <TextView android:id="@+id/forecast_icon_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌤️" android:textSize="14sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/forecast_temp_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°/--°" android:textColor="#FFFFFFFF" android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>