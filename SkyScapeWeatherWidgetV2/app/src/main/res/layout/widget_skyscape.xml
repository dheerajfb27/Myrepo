<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_glass_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌖ Bengaluru"
                android:textColor="#FFD4A373"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking weather…"
                android:textColor="#FFE8D8C4"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/refresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="⟳"
            android:textColor="#FFD4A373"
            android:textSize="25sp"
            android:background="@drawable/widget_metric_background" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/weather_icon"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="☀"
            android:textColor="#FFD4A373"
            android:textSize="43sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="#FFE8D8C4"
                android:textSize="42sp"
                android:fontFamily="sans" />
            <TextView
                android:id="@+id/condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for weather data"
                android:textColor="#FFE8D8C4"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/high_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H --°  ·  L --°"
                android:textColor="#FFBCA28C"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:id="@+id/feels_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Feels --°"
                android:textColor="#FFE8D8C4"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wind --"
                android:textColor="#FFD4A373"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:id="@+id/metrics_row"
        android:background="@drawable/widget_metric_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HUMIDITY" android:textColor="#FFBCA28C" android:textSize="8sp"/>
            <TextView android:id="@+id/humidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textColor="#FFE8D8C4" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UV INDEX" android:textColor="#FFBCA28C" android:textSize="8sp"/>
            <TextView android:id="@+id/uv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFD4A373" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRESSURE" android:textColor="#FFBCA28C" android:textSize="8sp"/>
            <TextView android:id="@+id/pressure" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="---- hPa" android:textColor="#FFE8D8C4" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:id="@+id/air_row"
        android:background="@drawable/widget_metric_background"
        android:orientation="horizontal"
        android:padding="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CITY AQI (US SCALE)" android:textColor="#FFBCA28C" android:textSize="8sp"/>
            <TextView android:id="@+id/aqi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFD4A373" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/aqi_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading air data…" android:textColor="#FFE8D8C4" android:textSize="8sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CARBON DIOXIDE" android:textColor="#FFBCA28C" android:textSize="8sp"/>
            <TextView android:id="@+id/co2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- ppm" android:textColor="#FFE8D8C4" android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modelled outdoor estimate" android:textColor="#FFBCA28C" android:textSize="8sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="7-DAY FORECAST"
        android:textColor="#FFE8D8C4"
        android:textStyle="bold"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/forecast_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:weightSum="7">
        <LinearLayout android:id="@+id/day0" style="@style/ForecastCell"/>
        <LinearLayout android:id="@+id/day1" style="@style/ForecastCell"/>
        <LinearLayout android:id="@+id/day2" style="@style/ForecastCell"/>
        <LinearLayout android:id="@+id/day3" style="@style/ForecastCell"/>
        <LinearLayout android:id="@+id/day4" style="@style/ForecastCell"/>
        <LinearLayout android:id="@+id/day5" style="@style/ForecastCell"/>
        <LinearLayout android:id="@+id/day6" style="@style/ForecastCell"/>
    </LinearLayout>
</LinearLayout>
