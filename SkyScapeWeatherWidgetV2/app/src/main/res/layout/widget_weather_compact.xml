<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_glass_green_background">

    <TextView
        android:id="@+id/compact_icon"
        android:layout_width="42dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="☀"
        android:textColor="#FF9AFF57"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="6dp">
        <TextView
            android:id="@+id/compact_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⌖ Bengaluru"
            android:textColor="#FF9AFF57"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/compact_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear sky"
            android:textColor="#FFF0FFE8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/compact_high_low"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="H 30° · L 21°"
            android:textColor="#FFA8D99A"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/compact_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="23°"
        android:textColor="#FFF0FFE8"
        android:textSize="28sp"
        android:fontFamily="sans"
        android:textStyle="bold"
        android:paddingStart="5dp"
        android:paddingEnd="7dp" />

    <TextView
        android:id="@+id/compact_refresh"
        android:layout_width="32dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="⟳"
        android:textColor="#FF9AFF57"
        android:textSize="22sp" />
</LinearLayout>
