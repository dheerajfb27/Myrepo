<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="5dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/widget_glass_green_background">

    <TextView
        android:id="@+id/compact_icon"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="☀"
        android:textColor="#FF9AFF57"
        android:textSize="25sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp">
        <TextView
            android:id="@+id/compact_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bengaluru"
            android:textColor="#FF9AFF57"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/compact_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sun, 11 Oct"
            android:textColor="#FFA8D99A"
            android:textSize="9sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/compact_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lovely weather"
            android:textColor="#FF9AFF57"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/compact_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="23°"
        android:textColor="#FFF0FFE8"
        android:textSize="25sp"
        android:fontFamily="sans"
        android:textStyle="bold"
        android:paddingStart="4dp"
        android:paddingEnd="5dp" />

    <LinearLayout
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="3dp">
        <TextView
            android:id="@+id/compact_feels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feels 24°"
            android:textColor="#FFF0FFE8"
            android:textSize="9sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/compact_wind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wind 12 km/h"
            android:textColor="#FF9AFF57"
            android:textSize="9sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/compact_high_low"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="H 30° · L 21°"
            android:textColor="#FFA8D99A"
            android:textSize="9sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/compact_refresh"
        android:layout_width="24dp"
        android:layout_height="34dp"
        android:gravity="center"
        android:text="⟳"
        android:textColor="#FF9AFF57"
        android:textSize="19sp" />
</LinearLayout>
