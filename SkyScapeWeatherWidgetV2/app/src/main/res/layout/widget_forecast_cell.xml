<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:background="@drawable/widget_metric_background">
    <TextView android:id="@+id/forecast_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textColor="#FFE8D8C4" android:textSize="9sp"/>
    <TextView android:id="@+id/forecast_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀" android:textColor="#FFD4A373" android:textSize="19sp"/>
    <TextView android:id="@+id/forecast_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFE8D8C4" android:textSize="10sp" android:textStyle="bold"/>
    <TextView android:id="@+id/forecast_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFBCA28C" android:textSize="9sp"/>
</LinearLayout>
